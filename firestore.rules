rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Administrador: custom claim 'admin: true' OU documento em admins/{uid}.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function validPublicStudentRegistration(studentId) {
      let student = request.resource.data;
      return isSignedIn()
        && student.keys().hasAll([
          'id', 'userId', 'name', 'dob', 'cpf', 'phone', 'email',
          'tshirtSize', 'pantsSize', 'status', 'paymentStatus',
          'belt', 'registrationDate', 'planType', 'planValue'
        ])
        && student.keys().hasOnly([
          'id', 'userId', 'name', 'dob', 'cpf', 'phone', 'email',
          'tshirtSize', 'pantsSize', 'emergencyContacts', 'status',
          'paymentStatus', 'belt', 'registrationDate', 'planType', 'planValue'
        ])
        && student.id == studentId
        && student.userId == request.auth.uid
        && student.name is string
        && student.name.size() >= 3
        && student.name.size() <= 150
        && student.email is string
        && student.email.size() <= 254
        && student.dob is string
        && student.cpf is string
        && student.cpf.size() >= 11
        && student.cpf.size() <= 14
        && student.phone is string
        && student.phone.size() >= 10
        && student.phone.size() <= 30
        && student.tshirtSize is string
        && student.pantsSize is string
        && (!student.keys().hasAny(['emergencyContacts']) || student.emergencyContacts is string)
        && student.status == 'Pendente'
        && student.paymentStatus == 'Pendente'
        && student.belt == 'Branca'
        && student.registrationDate is string
        && student.planType == 'Mensal'
        && student.planValue is number
        && student.planValue >= 0;
    }

    function validStudentOwnerUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && resource.data.userId == request.auth.uid
        && changed.hasOnly([
          'name', 'dob', 'cpf', 'phone', 'email', 'tshirtSize', 'pantsSize',
          'emergencyContacts', 'medicalHistory', 'photoUrl',
          'curriculumChecked', 'learningTasks', 'fikmAnnuityPaid'
        ])
        && (!changed.hasAny(['fikmAnnuityPaid']) || request.resource.data.fikmAnnuityPaid == false);
    }

    // Verifica se o documento pertence ao aluno autenticado via studentId
    function isOwnerViaStudentId(studentId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/students/$(studentId)).data.userId == request.auth.uid;
    }

    // ─── REGRA CORINGA ────────────────────────────────────────────────────────
    // Administradores têm acesso total a qualquer coleção não coberta abaixo.
    // As regras específicas abaixo têm precedência (OR lógico no Firestore).
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // ─── ALUNOS ───────────────────────────────────────────────────────────────
    match /students/{studentId} {
      // O cadastro público precisa autenticar a conta e só pode criar um cadastro pendente próprio.
      allow create: if isAdmin() || validPublicStudentRegistration(studentId);
      // Aluno lê e edita apenas o seu próprio documento; admin acessa todos
      allow read:   if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Aluno pode editar apenas perfil, foto e sua lista pessoal de aprendizado.
      allow update: if isAdmin() || validStudentOwnerUpdate();
      allow delete: if isAdmin();
    }

    // ─── PAGAMENTOS ───────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      allow read:  if isAdmin() || isOwnerViaStudentId(resource.data.studentId);
      allow write: if isAdmin();
    }

    // ─── PRESENÇAS ────────────────────────────────────────────────────────────
    match /attendance/{attendanceId} {
      allow read:  if isAdmin() || isOwnerViaStudentId(resource.data.studentId);
      allow write: if isAdmin();
    }

    // ─── EXAMES ───────────────────────────────────────────────────────────────
    match /exams/{examId} {
      allow read:  if isAdmin() || isOwnerViaStudentId(resource.data.studentId);
      allow write: if isAdmin();
    }

    // ─── SEMINÁRIOS ───────────────────────────────────────────────────────────
    match /seminars/{seminarId} {
      allow read:  if isAdmin() || isOwnerViaStudentId(resource.data.studentId);
      allow write: if isAdmin();
    }

    // ─── AVISOS ───────────────────────────────────────────────────────────────
    // Leitura pública (para o badge de notificação na tela de login dos alunos)
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── LOJA ─────────────────────────────────────────────────────────────────
    // Produtos: leitura pública; escrita apenas admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos: criação por qualquer usuário autenticado; leitura/edição admin
    match /pedidos/{orderId} {
      // Criação apenas pelo próprio usuário autenticado (uid deve bater)
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ─── APOSTILA (Currículo) ─────────────────────────────────────────────────
    // Qualquer aluno autenticado pode ler — necessário para a aba Currículo
    match /handbook/{docId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── FORMULÁRIOS PÚBLICOS ─────────────────────────────────────────────────
    match /womensMonth/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /giftCardOrders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

  }
}
